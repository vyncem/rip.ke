<div class="p-4">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm text-gray-500"><%= document_kind_label(@document.kind) %></p>
      <h1 class="text-3xl font-bold"><%= @document.display_title %></h1>
      <p class="mt-1 font-mono text-xs text-gray-500"><%= @document.path %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_document_path(@document),
            class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5" %>
      <%= link_to "Back to #{document_kind_label(@document.kind).downcase.pluralize}", document_index_path(@document.kind),
            class: "rounded-lg bg-gray-100 px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-200" %>
      <% if @document.html_url.present? %>
        <%= link_to "Open on GitHub", @document.html_url, target: "_blank", rel: "noopener",
              class: "rounded-lg bg-gray-100 px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-200" %>
      <% end %>
      <%= button_to "Delete", document_show_path(@document), method: :delete,
            form: { data: { turbo_confirm: "Delete #{@document.display_title}?" } },
            class: "rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700" %>
    </div>
  </div>

  <dl class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
    <% if @document.kind == 'post' %>
      <div>
        <dt class="font-medium text-gray-500">Date</dt>
        <dd class="text-gray-900"><%= @document.date.presence || "—" %></dd>
      </div>
    <% end %>
    <div>
      <dt class="font-medium text-gray-500">Layout</dt>
      <dd class="text-gray-900"><%= @document.layout.presence || "—" %></dd>
    </div>
    <% if @document.kind == 'page' %>
      <div>
        <dt class="font-medium text-gray-500">Permalink</dt>
        <dd class="text-gray-900"><%= @document.permalink.presence || "—" %></dd>
      </div>
    <% end %>
  </dl>

  <article class="mt-8 max-w-4xl leading-relaxed text-gray-900">
    <%= raw @document.body %>
  </article>

  <% if @document.extra_front_matter.any? %>
    <details class="mt-8 rounded-lg border border-gray-200 p-4">
      <summary class="cursor-pointer text-sm font-medium text-gray-900">Additional front matter</summary>
      <pre class="mt-3 overflow-x-auto whitespace-pre-wrap font-mono text-xs text-gray-700"><%= YAML.dump(@document.extra_front_matter).sub(/\A---\s*\n/, '') %></pre>
    </details>
  <% end %>

  <details class="mt-4 rounded-lg border border-gray-200 p-4">
    <summary class="cursor-pointer text-sm font-medium text-gray-900">Raw file</summary>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap font-mono text-xs text-gray-700"><%= @document.to_content %></pre>
  </details>
</div>
